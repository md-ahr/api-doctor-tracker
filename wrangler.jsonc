{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doctor-tracker-api",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-11-17",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "containers": [
    {
      "class_name": "ApiContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile",
        },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "ApiContainer",
      },
    ],
  },
  "exports": {
    "ApiContainer": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
